@{
    var title = ViewData["Title"] as string ?? "Kinxter Auth Control";
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@title</title>
  <style>
    :root{color-scheme:light;--ink:#17201d;--muted:#64716d;--line:#dfe5e2;--panel:#fff;--wash:#f3f6f4;--accent:#176b53;--accent-dark:#10523f;--danger:#a13a35;--success:#176b53}
    *{box-sizing:border-box}
    body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0;background:var(--wash);color:var(--ink)}
    a{color:var(--accent);text-decoration:none}
    a:hover{text-decoration:underline}
    .shell{min-height:100vh}
    .topbar{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:16px max(24px,calc((100vw - 1120px)/2));background:#11231d;color:#fff}
    .brand{display:flex;align-items:center;gap:12px;color:#fff;font-size:16px;font-weight:750;letter-spacing:.01em}
    .brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#d9f3e8;color:#124f3e;font-weight:900}
    .topbar-meta{display:flex;align-items:center;gap:16px;color:#d4ded9;font-size:14px}
    .topbar form{margin:0}
    .logout{padding:7px 11px;border:1px solid #4a5d56;border-radius:8px;background:transparent;color:#fff;font:inherit;cursor:pointer}
    .logout:hover{background:#20362f}
    main{max-width:1120px;margin:0 auto;padding:40px 24px 64px}
    .page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:26px}
    .eyebrow{margin:0 0 8px;color:var(--accent);font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
    h1{margin:0;font-size:32px;line-height:1.15;letter-spacing:-.025em}
    h2{margin:0;font-size:19px}
    .subtitle{margin:8px 0 0;color:var(--muted);line-height:1.55}
    .panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:0 8px 28px rgba(23,32,29,.045)}
    .panel-body{padding:24px}
    .realm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:16px}
    .realm-card{display:block;padding:22px;background:#fff;border:1px solid var(--line);border-radius:13px;color:inherit;transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease}
    .realm-card:hover{text-decoration:none;transform:translateY(-2px);border-color:#9ebcb1;box-shadow:0 9px 24px rgba(23,32,29,.07)}
    .realm-name{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:12px}
    .badge{display:inline-flex;padding:4px 8px;border-radius:999px;background:#e7f4ef;color:#145b47;font-size:12px;font-weight:750}
    .badge.off{background:#f0f1f1;color:#66706d}
    .realm-path{margin:0 0 18px;color:var(--muted);font:13px ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
    .stat{padding:10px;border-radius:9px;background:var(--wash)}
    .stat strong{display:block;font-size:17px}
    .stat span{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
    .field.full{grid-column:1/-1}
    label{display:block;margin:0 0 7px;font-size:13px;font-weight:750}
    input,select,textarea{width:100%;padding:11px 12px;border:1px solid #cbd4d0;border-radius:8px;background:#fff;color:var(--ink);font:inherit}
    textarea{resize:vertical;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;line-height:1.55}
    input:focus,select:focus,textarea:focus{outline:3px solid #d9eee7;border-color:var(--accent)}
    input[readonly]{background:#f4f6f5;color:#59645f}
    .help{margin:7px 0 0;color:var(--muted);font-size:12px;line-height:1.45}
    .choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .check{display:flex;align-items:flex-start;gap:10px;padding:13px;border:1px solid var(--line);border-radius:9px}
    .check input{width:18px;height:18px;margin:0}
    .check label{margin:0}
    .check label strong,.check label small{display:block}
    .check label small{margin-top:3px;color:var(--muted);font-weight:400;line-height:1.35}
    .actions{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:26px;padding-top:22px;border-top:1px solid var(--line)}
    .button{display:inline-flex;align-items:center;justify-content:center;padding:10px 15px;border:0;border-radius:8px;background:var(--accent);color:#fff;font:inherit;font-weight:750;cursor:pointer}
    .button:hover{background:var(--accent-dark);text-decoration:none}
    .button.secondary{background:#e7ece9;color:#26342f}
    .button.danger{background:var(--danger)}
    .notice{margin:0 0 20px;padding:12px 14px;border-radius:9px;font-size:14px}
    .notice.error{background:#fff0ef;color:var(--danger);border:1px solid #f3cecb}
    .notice.success{background:#eaf6f1;color:var(--success);border:1px solid #c9e8db}
    .login-shell{display:grid;place-items:center;min-height:100vh;padding:24px}
    .login-card{width:min(100%,420px);padding:30px}
    .login-card .brand{color:var(--ink);margin-bottom:26px}
    .login-card button{width:100%;margin-top:22px}
    .metadata{display:flex;gap:24px;flex-wrap:wrap;margin:20px 0 0;color:var(--muted);font-size:12px}
    .section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin:38px 0 16px}
    .client-list{overflow:hidden}
    .client-row{display:grid;grid-template-columns:minmax(220px,1.2fr) minmax(180px,1fr) auto;align-items:center;gap:18px;padding:18px 20px;color:inherit;border-bottom:1px solid var(--line)}
    .client-row:last-child{border-bottom:0}
    .client-row:hover{background:#f8faf9;text-decoration:none}
    .client-row strong,.client-row code{display:block}
    .client-row code{margin-top:5px;color:var(--muted);font-size:12px}
    .client-row small{display:block;margin-top:5px;color:var(--muted);font-size:11px;overflow-wrap:anywhere}
    .client-scopes{color:var(--muted);font-size:12px;overflow-wrap:anywhere}
    .secret-box{margin:0 0 20px;padding:18px;border:1px solid #e4c565;border-radius:11px;background:#fff9df}
    .secret-box p{margin:5px 0 12px;color:#695c31;font-size:13px}
    .secret-box code{display:block;padding:12px;border-radius:7px;background:#fff;overflow-wrap:anywhere;user-select:all}
    .danger-zone{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:22px;border-color:#efcfcd}
    .danger-zone form{margin:0;flex:0 0 auto}
    @@media(max-width:680px){.topbar{padding:14px 18px}.topbar-meta span{display:none}main{padding:28px 16px 48px}.page-head{display:block}.page-head .button{margin-top:16px}.form-grid,.choice-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.stats{grid-template-columns:repeat(3,1fr)}.section-head,.danger-zone{display:block}.section-head .button,.danger-zone form{margin-top:16px}.client-row{grid-template-columns:1fr}.client-row .badge{justify-self:start}}
  </style>
</head>
<body>
  @RenderBody()
</body>
</html>
