@model Kinxter.Auth.Rendering.Models.AuthLoginTwoFactorPageViewModel
@{
    var text = Kinxter.Auth.Rendering.AuthUiText.For(ViewData["Locale"] as string);
    Layout = "/Views/Auth/_Layout.cshtml";
    ViewData["Title"] = text["Two-factor authentication"];
}
<p class="eyebrow">@text["One more step"]</p>
<h1>@text["Verify it’s you"]</h1>
<p class="lead">@text["Enter the current code from your authenticator app."]</p>
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
  <p class="error">@text[Model.Error]</p>
}
<form class="auth-form" method="post">
  <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
  <label for="code">@text["Authenticator code"]</label>
  <input id="code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus>
  <button type="submit">@text["Verify"]</button>
</form>
