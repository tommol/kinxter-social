@model Kinxter.Auth.Rendering.Models.AuthDeviceVerificationPageViewModel
@{
    var text = Kinxter.Auth.Rendering.AuthUiText.For(ViewData["Locale"] as string);
    Layout = "/Views/Auth/_Layout.cshtml";
    ViewData["Title"] = text["Authorize device"];
}
<p class="eyebrow">@text["Device connection"]</p>
<h1>@text["Authorize a device"]</h1>
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
  <p class="error">@text[Model.Error]</p>
}
@if (!Model.HasValidRequest)
{
  <p class="lead">@text["Enter the code shown by the application or device."]</p>
  <form class="auth-form" method="get" action="@Model.VerificationPath">
    <label for="userCode">@text["Device code"]</label>
    <input id="userCode" name="user_code" value="@Model.UserCode" autocomplete="one-time-code" required autofocus>
    <button type="submit">@text["Continue"]</button>
  </form>
}
else
{
  <p class="lead">@text.Format("{0} is requesting access to this account.", Model.ApplicationName)</p>
  <dl>
    <dt>@text["Code"]</dt>
    <dd><code>@Model.UserCode</code></dd>
    <dt>@text["Scopes"]</dt>
    <dd>@(Model.Scopes.Length == 0 ? text["No additional scopes"] : string.Join(", ", Model.Scopes))</dd>
  </dl>
  <p>@text["Confirm only if this code exactly matches the code displayed on your device."]</p>
  <form class="split-actions" method="post" action="@Model.VerificationPath">
    <input type="hidden" name="__RequestVerificationToken" value="@Model.AntiforgeryToken">
    <input type="hidden" name="user_code" value="@Model.UserCode">
    <button type="submit" name="decision" value="accept">@text["Authorize"]</button>
    <button class="secondary" type="submit" name="decision" value="deny">@text["Deny"]</button>
  </form>
}
