@model Kinxter.Auth.Rendering.Models.AuthRegisterPageViewModel
@{
    var text = Kinxter.Auth.Rendering.AuthUiText.For(ViewData["Locale"] as string);
    Layout = "/Views/Auth/_Layout.cshtml";
    ViewData["Title"] = Model.SignupEnabled ? text["Create account"] : text["Signup disabled"];
}
@if (!Model.SignupEnabled)
{
  <p class="eyebrow">@text["Registration"]</p>
  <h1>@text["Signup disabled"]</h1>
  <p class="lead">@text["This space does not currently allow self-service registration."]</p>
}
else
{
  <p class="eyebrow">@text["Join at your pace"]</p>
  <h1>@text["Create account"]</h1>
  <p class="lead">@text["Start with only the essentials. You decide what to share later."]</p>
  @if (!string.IsNullOrWhiteSpace(Model.Error))
  {
    <p class="error">@text[Model.Error]</p>
  }
  @if (Model.ExternalProviders.Count > 0)
  {
    <div class="external-logins">
    @foreach (var provider in Model.ExternalProviders)
    {
      <form method="post" action="@provider.ActionPath">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
        <button type="submit">@text.Format("Continue with {0}", provider.DisplayName)</button>
      </form>
    }
    </div>
    <div class="divider">@text["or use email"]</div>
  }
  <form class="auth-form" method="post">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
    <label for="email">@text["Email"]</label>
    <input id="email" type="email" name="email" autocomplete="email" required autofocus>
    <label for="password">@text["Password"]</label>
    <input id="password" type="password" name="password" autocomplete="new-password" required>
    <button type="submit">@text["Create account"]</button>
  </form>
  <p class="switch-copy">@text["Already have an account?"] <a href="@Model.LoginPath?returnUrl=@Model.EscapedReturnUrl">@text["Sign in"]</a></p>
}
