@model Kinxter.Auth.Rendering.Models.AuthTotpSetupPageViewModel
@{
    var text = Kinxter.Auth.Rendering.AuthUiText.For(ViewData["Locale"] as string);
    Layout = "/Views/Auth/_Layout.cshtml";
    ViewData["Title"] = text["Authenticator app"];
}
<p class="eyebrow">@text["Protect your account"]</p>
<h1>@text["Set up MFA"]</h1>
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
  <p class="error">@text[Model.Error]</p>
}
<p class="lead">@text["Enter this key in your authenticator app, then verify a current code."]</p>
<code>@Model.Key</code>
<form class="auth-form" method="post">
  <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
  <label for="code">@text["Verification code"]</label>
  <input id="code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus>
  <button type="submit">@text["Enable MFA"]</button>
</form>
